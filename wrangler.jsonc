{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handwerk-planer",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handwerk-planer-db"
    }
  ],
  "observability": { "enabled": true }
}
